<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<title>AYHEM SUPER INTERACTIVE LIVE</title>
<style>
body{margin:0;padding:0;background:#111;color:#fff;font-family:sans-serif;overflow:hidden;}
header{padding:15px;text-align:center;font-size:1.6em;background:#222;position:absolute;width:100%;z-index:10;}
#ui-panel{position:absolute;top:60px;left:10px;padding:10px;background:rgba(20,20,20,0.8);border-radius:8px;z-index:20;}
button,select{margin:3px;padding:5px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;}
canvas{display:block;}
</style>
</head>
<body>
<header>AYHEM SUPER INTERACTIVE LIVE NETWORK</header>
<div id="ui-panel">
    <label>فلترة الشبكات:</label>
    <select id="networkFilter">
        <option value="all">كل الشبكات</option>
        <option value="wolf">WOLF ULTRA</option>
        <option value="sentient">SENTIENT MASTER</option>
        <option value="auto">AUTO-FULL</option>
    </select>
    <button id="refreshBtn">تحديث يدوي</button>
</div>
<canvas id="networkCanvas"></canvas>

<script src="https://cdn.jsdelivr.net/npm/three@0.154.0/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.154.0/examples/js/controls/OrbitControls.js"></script>

<script>
const canvas=document.getElementById('networkCanvas');
const scene=new THREE.Scene();
const camera=new THREE.PerspectiveCamera(75,window.innerWidth/window.innerHeight,0.1,5000);
const renderer=new THREE.WebGLRenderer({canvas:canvas,antialias:true});
renderer.setSize(window.innerWidth,window.innerHeight);
camera.position.set(0,0,600);
const controls=new THREE.OrbitControls(camera,renderer.domElement);
controls.enableDamping=true;
controls.dampingFactor=0.05;
controls.enableZoom=true;
controls.enablePan=true;

let cells=[], links=[], cellMeshes=[], linkMeshes=[];

// فلترة حسب الشبكة
let networkFilter = "all";
document.getElementById('networkFilter').addEventListener('change',(e)=>{
    networkFilter = e.target.value;
});

// زر التحديث اليدوي
document.getElementById('refreshBtn').addEventListener('click',()=>fetchCells());

function createCellMesh(cell){
    const size = 5 + 20*cell.energy;
    const geometry=new THREE.SphereGeometry(size,16,16);
    let color;
    if(cell.network=="wolf") color = new THREE.Color(0.7,0.1,0.1);
    else if(cell.network=="sentient") color = new THREE.Color(0.1,0.7,0.1);
    else color = new THREE.Color(0.1,0.3,0.7);
    const material=new THREE.MeshBasicMaterial({color:color});
    const mesh=new THREE.Mesh(geometry,material);
    mesh.position.set(cell.x,cell.y,cell.z);
    scene.add(mesh);
    return mesh;
}

function createLinkMesh(a,b){
    const material=new THREE.LineBasicMaterial({color:new THREE.Color(Math.random(),Math.random(),Math.random())});
    const points=[new THREE.Vector3(a.x,a.y,a.z), new THREE.Vector3(b.x,b.y,b.z)];
    const geometry=new THREE.BufferGeometry().setFromPoints(points);
    const line=new THREE.Line(geometry,material);
    scene.add(line);
    return line;
}

// جلب البيانات الحية للشبكات مجتمعة
async function fetchCells(){
    try{
        const res = await fetch('/super-report');
        const data = await res.json();
        cells = data.results.map(c=>({
            name:c.cell,
            network:c.network||"auto",
            x:c.x,
            y:c.y,
            z:c.z,
            energy:c.energy,
            awareness:c.awareness,
            prediction:c.prediction
        })).filter(c=>{
            return networkFilter==="all" || c.network===networkFilter;
        });

        links=[];
        for(let i=0;i<cells.length;i++){
            for(let j=i+1;j<cells.length;j++){
                if(Math.random()>0.6) links.push([i,j]);
            }
        }

    }catch(e){console.error("خطأ في جلب البيانات:",e);}
}

// تحديث المشهد
function updateScene(){
    cellMeshes.forEach(m=>scene.remove(m));
    linkMeshes.forEach(l=>scene.remove(l));
    cellMeshes=[];
    linkMeshes=[];

    cells.forEach(c=>{
        c.x+=Math.random()*4-2;
        c.y+=Math.random()*4-2;
        c.z+=Math.random()*4-2;
        c.energy=Math.min(1,Math.max(0,c.energy + (Math.random()*0.05-0.025)));
        const mesh=createCellMesh(c);
        cellMeshes.push(mesh);
    });

    links.forEach(l=>{
        let a=cells[l[0]], b=cells[l[1]];
        let line=createLinkMesh(a,b);
        linkMeshes.push(line);
    });
}

// الحلقة الرئيسية
async function animate(){
    await fetchCells();
    updateScene();
    controls.update();
    renderer.render(scene,camera);
    requestAnimationFrame(animate);
}

window.addEventListener('resize',()=>{
    camera.aspect=window.innerWidth/window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth,window.innerHeight);
});

animate();
</script>
</body>
</html>
