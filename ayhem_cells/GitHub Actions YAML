# .github/workflows/ayhem_cells_automation.yml
name: AYHEM - خلايا الذئب الذكية

on:
  push:
    branches: [main]
  schedule:
    - cron: '0 * * * *'  # تشغيل كل ساعة لتحديث الخلايا
  workflow_dispatch:

jobs:
  run_cells:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        cell: [CH1_RARITY, CH2_HUMILITY, CH3_SPARSE_WORDS, CH4_IMAGE, CH5_INDEPENDENCE, CH6_WISE_POWER]

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v3

      - name: Setup Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.12'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests pyyaml

      - name: Execute Cell AI
        env:
          CELL_ID: ${{ matrix.cell }}
        run: |
          python ./ayhem_cells/run_cell.py $CELL_ID
